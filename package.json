{
  "name": "facade-lighting-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone facade-lighting tender portal with resumable Tenderkart sync and document indexing",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node server/index.cjs",
    "test": "node --test tests/*.test.cjs",
    "import:snapshot": "node scripts/import-snapshot.cjs",
    "index:documents": "node scripts/index-documents.cjs",
    "package": "node scripts/package.cjs"
  },
  "dependencies": {
    "cheerio": "1.0.0",
    "exceljs": "4.4.0",
    "express": "4.21.2",
    "pdf-parse": "1.1.1",
    "unzipper": "0.10.14",
    "archiver": "5.3.2"
  }
}
